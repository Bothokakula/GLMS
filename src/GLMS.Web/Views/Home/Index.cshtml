@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="display-6 fw-bold">
            <i class="bi bi-speedometer2"></i> Dashboard
        </h1>
        <p class="text-muted">Welcome to the Global Logistics Management System</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">
                <div class="display-4 text-primary mb-3">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h5 class="card-title">Clients</h5>
                <p class="card-text text-muted">Manage your client relationships and contact information.</p>
                <a asp-controller="Clients" asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-right"></i> View Clients
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">
                <div class="display-4 text-success mb-3">
                    <i class="bi bi-file-earmark-text-fill"></i>
                </div>
                <h5 class="card-title">Contracts</h5>
                <p class="card-text text-muted">Track contract lifecycles, statuses, and signed agreements.</p>
                <a asp-controller="Contracts" asp-action="Index" class="btn btn-outline-success">
                    <i class="bi bi-arrow-right"></i> View Contracts
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">
                <div class="display-4 text-warning mb-3">
                    <i class="bi bi-clipboard2-check-fill"></i>
                </div>
                <h5 class="card-title">Service Requests</h5>
                <p class="card-text text-muted">Create and track service requests with live currency conversion.</p>
                <a asp-controller="Contracts" asp-action="Index" class="btn btn-outline-warning">
                    <i class="bi bi-arrow-right"></i> Browse Contracts
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-lightning-fill text-warning"></i> Quick Actions
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Clients" asp-action="Create" class="list-group-item list-group-item-action">
                    <i class="bi bi-plus-circle text-primary me-2"></i> Add New Client
                </a>
                <a asp-controller="Contracts" asp-action="Create" class="list-group-item list-group-item-action">
                    <i class="bi bi-plus-circle text-success me-2"></i> Create New Contract
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-info-circle-fill text-info"></i> System Information
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><strong>System:</strong> Global Logistics Management System (GLMS)</li>
                    <li class="mb-2"><strong>Version:</strong> 1.0.0</li>
                    <li><strong>Currency Support:</strong> USD &harr; ZAR (live rates)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
