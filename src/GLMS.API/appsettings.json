{
  // ==========================================================================
  // File: appsettings.json
  // Purpose: Central configuration for the GLMS API, including database
  //          connection strings, JWT authentication parameters, and logging
  //          levels. Values here can be overridden by environment-specific
  //          files (appsettings.Development.json) or environment variables.
  // ==========================================================================

  // Entity Framework Core data access (Microsoft, 2024, EF Core documentation)
  // Default connection targets SQL Server LocalDB for development. In production
  // or Docker environments, override via the GLMS_CONNECTION_STRING env variable.
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GLMSDB;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // JWT Bearer authentication (Microsoft, 2024, ASP.NET Core Security documentation)
  // Key: symmetric secret used to sign and validate tokens. The value below is a
  // DEVELOPMENT-ONLY placeholder; override it with the Jwt__Key environment
  // variable anywhere outside local development (docker-compose does this via .env).
  // Issuer/Audience: must match the values in Program.cs token validation parameters.
  "Jwt": {
    "Key": "dev-only-placeholder-key-change-me-0123456789abcdef",
    "Issuer": "GLMS.API",
    "Audience": "GLMS.Web"
  },

  // Logging configuration — "Information" captures general request flow;
  // ASP.NET Core internals are limited to "Warning" to reduce noise.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Accept requests from any host header. In production, restrict to known domains.
  "AllowedHosts": "*"
}
